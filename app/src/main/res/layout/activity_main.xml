<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#F4F6FA">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="0dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:background="@drawable/bg_header_gradient">

                    <!-- Title + last updated -->
                    <LinearLayout
                        android:id="@+id/headerTop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/stat_sys_data_bluetooth"
                            app:tint="@android:color/white" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RF Monitor"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:paddingStart="8dp"/>

                        <ImageButton
                            android:id="@+id/btnRefresh"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:backgroundTint="@android:color/transparent"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_popup_sync"
                            android:contentDescription="Refresh"
                            app:tint="@android:color/white" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/headerTop"
                        android:layout_marginTop="6dp"
                        android:text="Awaiting hardware..."
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp"/>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvLastUpdated"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Active"
                                android:textColor="#E6FFFFFF"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/tvActive"
                                android:text="0"
                                android:textStyle="bold"
                                android:textSize="20sp"
                                android:textColor="@android:color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:text="Avg Signal"
                                android:textColor="#E6FFFFFF"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/tvAvgSignal"
                                android:text="-- dBm"
                                android:textStyle="bold"
                                android:textSize="20sp"
                                android:textColor="@android:color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:text="Bands"
                                android:textColor="#E6FFFFFF"
                                android:textSize="12sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:id="@+id/tvBands"
                                android:text="1"
                                android:textStyle="bold"
                                android:textSize="20sp"
                                android:textColor="@android:color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Segmented tabs -->

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.chip.ChipGroup
                android:layout_gravity="center"
                android:id="@+id/chipsTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                app:chipSpacing="8dp"
                app:selectionRequired="true"
                app:singleSelection="true"
                tools:ignore="NotSibling">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFrequencies"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Alerts"
                    app:checkedIconVisible="false" />


                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGraphs"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Graphs"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSpectrum"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spectrum"
                    app:checkedIconVisible="false" />

            </com.google.android.material.chip.ChipGroup>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardCornerRadius="14dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Title row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivDot1"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/shape_dot_gray"
                            android:contentDescription="images" />

                        <TextView
                            android:id="@+id/tvTitle1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/fm_radio_1"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:paddingStart="8dp"
                            android:textColor="#1A1A1A"
                            tools:ignore="RtlSymmetry" />

                        <TextView
                            android:id="@+id/tvActivePill1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="standby / offline"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:background="@drawable/bg_pill_neutral"/>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:weightSum="4">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:text="Frequency" android:textSize="12sp" android:textColor="#7A7A7A" android:layout_height="wrap_content"
                                android:layout_width="wrap_content" />
                            <TextView android:id="@+id/tvFrequency1" android:text="2.424 GHz" android:textStyle="bold" android:textColor="#1A1A1A"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:text="Strength" android:textSize="12sp" android:textColor="#7A7A7A"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content" />
                            <TextView android:id="@+id/tvStrength1" android:text="-- dBm" android:textStyle="bold" android:textColor="#1A1A1A" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:text="Bandwidth" android:textSize="12sp" android:textColor="#7A7A7A" android:layout_height="wrap_content"
                                android:layout_width="wrap_content" />
                            <TextView android:id="@+id/tvBandwidth" android:text="2 MHz" android:textStyle="bold" android:textColor="#1A1A1A" android:layout_height="wrap_content"
                                android:layout_width="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:text="Modulation" android:textSize="12sp" android:textColor="#7A7A7A"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content" />
                            <TextView android:id="@+id/tvModulation1" android:text="GFSK" android:textStyle="bold" android:textColor="#1A1A1A"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Signal Quality -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Signal Quality"
                        android:textSize="12sp"
                        android:textColor="#7A7A7A"
                        android:layout_marginTop="12dp"/>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressQuality1"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        app:trackThickness="8dp"
                        app:trackCornerRadius="4dp"
                        app:indicatorColor="?attr/colorPrimary"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
