<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:id="@+id/main"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSecurityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="true"
            app:strokeColor="#E6E9EF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Title row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivSecurityStatusIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_secure"
                        app:tint="#D72E2E"
                        />

                    <TextView
                        android:id="@+id/tvSecurityTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:text="Security Status"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Unauthorized block -->
                <LinearLayout
                    android:id="@+id/boxUnauthorizedSignals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FFF3F3"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUnauthorizedTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unauthorized Signals"
                            android:textStyle="bold"
                            android:textColor="#991111"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvUnauthorizedSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active threats detected"
                            android:textColor="#B14A4A"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Count pill -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipUnauthorizedCount"
                       android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        app:chipMinHeight="32dp"
                        app:chipBackgroundColor="@color/design_default_color_error"
                        app:chipStrokeWidth="0dp"

                        app:checkedIconVisible="false"
                        app:closeIconVisible="false"
                        app:ensureMinTouchTargetSize="false" />
                </LinearLayout>

                <!-- Authorized block -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#F2FFF6"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAuthorizedTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Authorized Signals"
                            android:textStyle="bold"
                            android:textColor="#0B5D2A"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvAuthorizedSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Known and safe"
                            android:textColor="#3D7E54"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Count pill -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAuthorizedCount"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6"
                        app:chipMinHeight="32dp"
                        app:chipBackgroundColor="#0B1020"
                        app:chipStrokeWidth="0dp"

                       android:textColor="@color/white"
                        app:checkedIconVisible="false"
                        app:closeIconVisible="false"
                        app:ensureMinTouchTargetSize="false" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSecurityWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="true"
            app:strokeColor="#FFD6D6"
            app:strokeWidth="1dp"
            android:backgroundTint="#FFF8F8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="#D72E2E"
                     />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWarningTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Security Warning"
                        android:textStyle="bold"
                        android:textColor="#B32121"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvWarningBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="2 unauthorized signals have been detected in your area. These signals may indicate potential security threats or unauthorized devices."
                        android:textColor="#7A3A3A"
                        android:textSize="12sp"
                        tools:text="X unauthorized signals have been detected in your area. These signals may indicate potential security threats or unauthorized devices." />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      
        <com.google.android.material.card.MaterialCardView
       
            android:id="@+id/cardThreatDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="true"
            app:strokeColor="#F2B9B9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivThreatIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="#D72E2E"
                        />

                    <TextView
                        android:id="@+id/tvThreatTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:text="Unknown Signal"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        tools:text="Unknown Signal" />

                    <TextView
                        android:id="@+id/tvBadgeUnauthorized"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="unauthorized"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="@drawable/bg_pill_red" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/boxSecurityAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#FFF3F3"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivAlertIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="#D72E2E"
                        />

                    <TextView
                        android:id="@+id/tvAlertText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Security Alert: This signal is not authorized and may pose a security risk."
                        android:textColor="#9B1C1C"
                        android:textSize="12sp"
                        tools:text="Security Alert: This signal is not authorized and may pose a security risk." />
                </LinearLayout>

                <!-- 2x2 grid: Frequency | Strength | Bandwidth | Modulation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="2">

                    <!-- Left column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/fre"
                                app:tint="#7A7A7A"
                                />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Frequency"
                                    android:textSize="12sp"
                                    android:textColor="#7A7A7A" />

                                <TextView
                                    android:id="@+id/tvFreqValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3.456 GHz"
                                    android:textStyle="bold"
                                    android:textColor="#1A1A1A"
                                    tools:text="3.456 GHz" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/band"
                                app:tint="#7A7A7A"
                                />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bandwidth"
                                    android:textSize="12sp"
                                    android:textColor="#7A7A7A" />

                                <TextView
                                    android:id="@+id/tvBandwidthValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="5 MHz"
                                    android:textStyle="bold"
                                    android:textColor="#1A1A1A"
                                    tools:text="5 MHz" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/bar"
                                app:tint="#7A7A7A"
                                />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Strength"
                                    android:textSize="12sp"
                                    android:textColor="#7A7A7A" />

                                <TextView
                                    android:id="@+id/tvStrengthValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-52 dBm"
                                    android:textStyle="bold"
                                    android:textColor="#1A1A1A"
                                    tools:text="-52 dBm" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Modulation -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/am"
                                app:tint="#7A7A7A"
                                />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Modulation"
                                    android:textSize="12sp"
                                    android:textColor="#7A7A7A" />

                                <TextView
                                    android:id="@+id/tvModulationValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Unknown"
                                    android:textStyle="bold"
                                    android:textColor="#1A1A1A"
                                    tools:text="Unknown" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- Signal Quality row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Signal Quality"
                        android:textColor="#7A7A7A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvQualityPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="52%"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        tools:text="52%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressSignalQuality"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    app:trackThickness="8dp"
                    app:trackCornerRadius="4dp"
                    app:indicatorColor="#F4B000" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
